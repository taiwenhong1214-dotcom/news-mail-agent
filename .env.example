# 本地开发用：复制为 .env（已被 .gitignore 忽略），填入真实值。
# 线上（GitHub Actions）的值放在仓库 Settings → Secrets and variables → Actions。

# ---- Cloudflare D1 ----
CF_ACCOUNT_ID=
CF_API_TOKEN=            # 权限：Account → D1 → Edit
D1_DATABASE_ID=
# 本地不想连 D1 时：DB_BACKEND=sqlite（或命令行加 --sqlite），数据写到 ./local.db
# DB_BACKEND=sqlite

# ---- Telegram ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- LLM（OpenAI 兼容接口）----
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=
LLM_MODEL=gemini-3.5-flash-lite
LLM_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-2.5-flash
# LLM_REASONING_EFFORT=low   # 不支持该参数的模型会自动去掉

# ---- 可选调参（括号内为默认值）----
# WINDOW_HOURS=48            # 只保留多少小时内的条目
# SIMHASH_DISTANCE=3         # 汉明距离 ≤ 此值视为同一事件
# SIMHASH_WINDOW_HOURS=24
# MAX_SCORE_BATCHES=8        # 每次运行最多打分几批（每批 10 条）
# PUSH_THRESHOLD=7
# PUSH_MAX_PER_RUN=8
# PUSH_MAX_AGE_HOURS=12      # 更早的高分新闻只进日报
# DIGEST_HOUR_MYT=8
# DRY_RUN=1                  # 不发 Telegram，只打印
